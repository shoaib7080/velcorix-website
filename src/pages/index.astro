                <li class="mb-2">
                  <i class="fas fa-check-circle text-primary me-2"></i> Quality
                  Assurance
                </li>
                <li class="mb-2">
                  <i class="fas fa-check-circle text-primary me-2"></i> Expert
                  Engineering Team
                </li>
                <li class="mb-2">
                  <i class="fas fa-check-circle text-primary me-2"></i> Timely
                  Delivery
                </li>
              </ul>
              <a href="/about.html" class="btn btn-outline-dark">Read More</a>
            </div>
          </div>
        </div>
      </section>

      <!-- What we do section  -->
