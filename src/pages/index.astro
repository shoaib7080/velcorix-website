---
import BaseLayout from "../layouts/BaseLayout.astro";

const meta = {
  title: "Velcorix - Mechanical Trading & Consultancy",
  description: "Velcorix is a premier mechanical trading and consultancy firm in UAE, providing expert oil & gas services, industrial equipment rentals, shutdown management, and EPC advisory.",
  canonical: "https://www.velcorix.com/",
  swiper: true,
  preloadImage: "/assets/images/hero/DSC_2319.JPG",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Velcorix",
      "image": "https://www.velcorix.com/assets/images/logo/velcorix-logo.png",
      "@id": "https://www.velcorix.com/",
      "url": "https://www.velcorix.com/",
      "telephone": "+971501234567",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dubai Industrial City",
        "addressLocality": "Dubai",
        "addressRegion": "Dubai",
        "postalCode": "00000",
        "addressCountry": "AE"
      },
      "description": "Velcorix is a premier mechanical trading and consultancy firm in UAE, providing expert oil & gas services, industrial equipment rentals, shutdown management, and EPC advisory.",
      "sameAs": [
        "https://www.linkedin.com/company/velcorix",
        "https://www.facebook.com/velcorix"
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Hero Slider Section -->
      <section class="hero-section">
        <div class="swiper hero-slider">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <picture class="hero-picture">
                <source type="image/avif" srcset="/assets/images/hero/optimized/DSC_2307-800.avif 800w, /assets/images/hero/optimized/DSC_2307-1200.avif 1200w, /assets/images/hero/optimized/DSC_2307-1920.avif 1920w" sizes="(max-width: 768px) 100vw, 1200px">
                <source type="image/webp" srcset="/assets/images/hero/optimized/DSC_2307-800.webp 800w, /assets/images/hero/optimized/DSC_2307-1200.webp 1200w, /assets/images/hero/optimized/DSC_2307-1920.webp 1920w" sizes="(max-width: 768px) 100vw, 1200px">
                <img class="hero-img" src="/assets/images/hero/optimized/DSC_2307-1200.jpg" srcset="/assets/images/hero/optimized/DSC_2307-800.jpg 800w, /assets/images/hero/optimized/DSC_2307-1200.jpg 1200w, /assets/images/hero/optimized/DSC_2307-1920.jpg 1920w" sizes="(max-width: 768px) 100vw, 1200px" alt="A Partner You Can Rely On" width="1920" height="900" loading="lazy" decoding="async">
              </picture>
              <div class="hero-overlay"></div>
              <div class="container hero-content">
                <h2 class="hero-title text-white">A Partner You Can Rely On</h2>
                <p class="hero-subtitle">
                  Responsive, compliant, and technically driven support.
                </p>
                <a href="/contact.html" class="btn btn-primary btn-lg">Get in Touch</a>
              </div>
            </div>

            <!-- Slide 1 (LCP - eager + preload) -->
            <div class="swiper-slide">
              <picture class="hero-picture">
                <source type="image/avif" srcset="/assets/images/hero/optimized/DSC_2319-800.avif 800w, /assets/images/hero/optimized/DSC_2319-1200.avif 1200w, /assets/images/hero/optimized/DSC_2319-1920.avif 1920w" sizes="(max-width: 768px) 100vw, 1200px">
                <source type="image/webp" srcset="/assets/images/hero/optimized/DSC_2319-800.webp 800w, /assets/images/hero/optimized/DSC_2319-1200.webp 1200w, /assets/images/hero/optimized/DSC_2319-1920.webp 1920w" sizes="(max-width: 768px) 100vw, 1200px">
                <img class="hero-img" src="/assets/images/hero/optimized/DSC_2319-1200.jpg" srcset="/assets/images/hero/optimized/DSC_2319-800.jpg 800w, /assets/images/hero/optimized/DSC_2319-1200.jpg 1200w, /assets/images/hero/optimized/DSC_2319-1920.jpg 1920w" sizes="(max-width: 768px) 100vw, 1200px" alt="End-to-End Oil &amp; Gas Consultancy Services" width="1920" height="900" loading="eager" decoding="async" fetchpriority="high">
              </picture>
              <div class="hero-overlay"></div>
              <div class="container hero-content">
                <h1 class="hero-title">
                  End-to-End Oil &amp; Gas Consultancy Services
                </h1>
                <p class="hero-subtitle">
                  From shutdown planning to EPC advisory and pre-commissioning
                  support.
                </p>
                <a href="/services.html" class="btn btn-primary btn-lg">Explore our Services</a>
              </div>
            </div>

            <!-- Slide 2 -->
            <div class="swiper-slide">
              <picture class="hero-picture">
                <source type="image/avif" srcset="/assets/images/hero/optimized/DSC_2311-800.avif 800w, /assets/images/hero/optimized/DSC_2311-1200.avif 1200w, /assets/images/hero/optimized/DSC_2311-1920.avif 1920w" sizes="(max-width: 768px) 100vw, 1200px">
