---
import BaseLayout from "../layouts/BaseLayout.astro";

const meta = {
  title: "Our Services - Velcorix",
  description: "Comprehensive industrial services in UAE. Velcorix specializes in EPC, pre-commissioning, flange management, pneumatic testing, and project management for oil & gas and industrial sectors.",
  canonical: "https://www.velcorix.com/services.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background:
            linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url(&quot;images/service/service-8.jpg&quot;);
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Industrial &amp; Mechanical Services</h1>
          <p class="lead">Comprehensive Solutions for Industrial Excellence</p>
        </div>
      </header>

      <!-- Intro Section -->
      <section class="py-5 bg-light">
        <div class="container text-center">
          <p class="lead mb-0">
            Velcorix offers a diverse portfolio of specialized engineering,
            project management, and manpower services. From simple installations
            to complex shutdown management, we deliver precision and safety across
            the UAE and GCC region.
          </p>
        </div>
      </section>

      <!-- Services Grid -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <!-- 1. EPC -->
            <div class="col-md-4 mb-4">
              <a href="/services/epc.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon">
                    <i class="fas fa-drafting-compass"></i>
                  </div>
                  <h3>EPC Services</h3>
                  <p>
                    End-to-end Engineering, Procurement, and Construction services
                    for industrial projects.
                  </p>
                </div>
              </a>
            </div>

            <!-- 2. Oil & Gas Pre-commissioning -->
            <div class="col-md-4 mb-4">
              <a href="/services/pre-commissioning.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-vial"></i></div>
                  <h3>Oil &amp; Gas Pre-commissioning</h3>
                  <p>
                    Comprehensive testing and preparation ensuring systems are
                    ready for startup.
                  </p>
                </div>
              </a>
            </div>

            <!-- 3. Shutdown Management -->
            <div class="col-md-4 mb-4">
              <a href="/shutdown-management.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-power-off"></i></div>
                  <h3>Shutdown Management</h3>
                  <p>
                    Strategic planning and execution for plant turnarounds and
                    maintenance outages.
                  </p>
                </div>
              </a>
            </div>

            <!-- 4. Consultancy & Advisory -->
            <div class="col-md-4 mb-4">
              <a href="/consultancy-advisory.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-handshake"></i></div>
                  <h3>Consultancy &amp; Advisory</h3>
                  <p>
                    Expert guidance on operational efficiency, safety compliance,
                    and project feasibility.
                  </p>
                </div>
              </a>
            </div>

            <!-- 5. Specialised Services -->
            <div class="col-md-4 mb-4">
              <a href="/services/specialised-services.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-oil-well"></i></div>
                  <h3>Specialised Services</h3>
                  <p>
                    Key sectors including Oil &amp; Gas Upstream/Downstream,
                    Petrochemical, and Offshore.
                  </p>
                </div>
              </a>
            </div>

            <!-- 6. Flange Management -->
            <div class="col-md-4 mb-4">
              <a href="/services/flange-management.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-ring"></i></div>
                  <h3>Flange Management</h3>
                  <p>
                    Integrated bolting solutions: Torqueing, Tensioning,
                    Machining, and Joint Integrity.
                  </p>
                </div>
              </a>
            </div>

            <!-- 7. Specialised Manpower -->
            <div class="col-md-4 mb-4">
              <a href="/services/specialised-manpower.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-users-cog"></i></div>
                  <h3>Specialised Manpower</h3>
                  <p>
                    Skilled workforce for Shutdowns, Pre-commissioning, Lifting,
                    and HVAC projects.
                  </p>
                </div>
              </a>
            </div>

            <!-- 8. Pneumatic Testing -->
            <div class="col-md-4 mb-4">
              <a href="/services/pneumatic-testing.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-wind"></i></div>
                  <h3>Pneumatic Testing</h3>
                  <p>
                    Air and nitrogen pressure testing for sensitive piping and
                    vessel systems.
                  </p>
                </div>
              </a>
            </div>

            <!-- 9. Hot Tapping -->
            <div class="col-md-4 mb-4">
              <a href="/services/hot-tapping.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-fire"></i></div>
                  <h3>Hot Tapping</h3>
                  <p>
                    Safe pipeline intervention and branching without system
                    shutdown.
                  </p>
                </div>
              </a>
            </div>

            <!-- 10. Project Management -->
            <div class="col-md-4 mb-4">
              <a href="/services/project-management.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-tasks"></i></div>
                  <h3>Project Management</h3>
                  <p>
                    Dedicated oversight to ensure projects are delivered on time
                    and within budget.
                  </p>
                </div>
              </a>
            </div>

            <!-- 11. Engineering Construction -->
            <div class="col-md-4 mb-4">
              <a href="/services/engg-construction.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-hard-hat"></i></div>
                  <h3>Engineering Construction</h3>
                  <p>
                    Civil and mechanical construction services for industrial
                    infrastructure.
                  </p>
                </div>
              </a>
            </div>

            <!-- 12. Crane Installation -->
            <div class="col-md-4 mb-4">
              <a href="/services/crane-installation.html" class="text-decoration-none text-dark">
                <div class="service-card text-center h-100">
                  <div class="service-icon"><i class="fas fa-crutch"></i></div>
                  <h3>Crane Installation</h3>
                  <p>
                    Expert erection, dismantling, and maintenance of Tower and EOT
                    cranes.
                  </p>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Call to Action -->
      <section class="cta-section text-white">
        <div class="container text-center">
          <h2 class="cta-heading mb-4">Need a Tailored Solution?</h2>
          <p class="lead">
            Contact our engineering team to discuss your specific project
            requirements.
          </p>
          <a href="/contact.html" class="btn btn-light mt-3">Contact Us</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
