---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Bolt Torquing & Tensioning - Velcorix Services",
  description: "Expert hydraulic bolt torquing and tensioning services in UAE. Velcorix provides precision tightening and load control for leak-free flange connections in critical industries.",
  canonical: "https://www.velcorix.com/services/bolt-torquing-tensioning.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Bolt Torquing & Tensioning",
      "description": "Expert hydraulic bolt torquing and tensioning services in UAE. Velcorix provides precision tightening and load control for leak-free flange connections in critical industries.",
      "serviceType": "Bolt Torquing & Tensioning",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/services/bolt-torquing-tensioning.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Bolt Torquing & Tensioning",
          "item": "https://www.velcorix.com/services/bolt-torquing-tensioning.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background:
            linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url(&quot;../assets/images/services/DSC_2415.JPG&quot;);
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Bolt Torquing &amp; Tensioning</h1>
          <p class="lead">Integrated Solutions for Leak-Free Joint Integrity</p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/services/bolt-torque-2.webp" class="img-fluid shadow intro-image" alt="Bolt Torquing &amp; Tensioning" onerror="
                  this.src =
                    'https://placehold.co/800x400?text=Integrated+Bolting'
                ">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Precision Bolting Solutions</h2>
              <p>
                The integrity of any piping system relies on the quality of its
                bolted connections. Velcorix provides expert hydraulic bolt
                torquing and tensioning services, ensuring every flange is secured
                to the precise specification required for safe, leak-free
                operation.
              </p>
              <p>
                <strong>Torquing:</strong> We utilize calibrated hydraulic torque
                wrenches to apply controlled rotational force, ideal for standard
                flange connections.
              </p>
              <p>
                <strong>Tensioning:</strong> For critical or large-diameter
                joints, we use hydraulic tensioners to apply direct axial load,
                eliminating friction and ensuring uniform gasket compression.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Our Capabilities</h2>
          </div>
          <div class="row g-4">
            <!-- Torquing Block -->
            <h4 class="mb-3 text-primary fw-bold border-bottom pb-2 d-inline-block">
              Hydraulic Torquing
            </h4>
            <div class="row g-4 mb-4">
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                  <div>
                    <h5 class="fw-bold mb-1">Low Profile &amp; Square Drive</h5>
                    <p class="text-muted mb-0">
                      Versatile tooling for restricted access areas and standard
                      applications.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                  <div>
                    <h5 class="fw-bold mb-1">Joint Integrity Mgmt</h5>
                    <p class="text-muted mb-0">
                      Complete flange management (tagging, mapping, database
                      logging).
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tensioning Block -->
            <h4 class="mb-3 text-primary fw-bold border-bottom pb-2 d-inline-block">
              Hydraulic Tensioning
            </h4>
            <div class="row g-4">
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                  <div>
                    <h5 class="fw-bold mb-1">Topside &amp; Subsea</h5>
                    <p class="text-muted mb-0">
                      Specialized tensioners for topside piping and underwater
                      flange tightening.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                  <div>
                    <h5 class="fw-bold mb-1">Synchronous Loading</h5>
                    <p class="text-muted mb-0">
                      Simultaneous tensioning of 50% or 100% of bolts for even
                      load distribution.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                  <div>
                    <h5 class="fw-bold mb-1">Wind &amp; Structural</h5>
                    <p class="text-muted mb-0">
                      Foundation and tower flange tensioning for renewable energy
                      projects.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex align-items-start">
                  <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                  <div>
                    <h5 class="fw-bold mb-1">Manpower &amp; Rental</h5>
                    <p class="text-muted mb-0">
                      Provision of ECITB certified technicians and daily/monthly
                      equipment rental.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-network-wired"></i>
                </div>
                <h4>Pipelines</h4>
                <p class="small text-muted mb-0">
                  High-pressure flow line assembly.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-cogs"></i>
                </div>
                <h4>Exchangers</h4>
                <p class="small text-muted mb-0">
                  Girth flanges and channel covers.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-fan"></i>
                </div>
                <h4>Power Gen</h4>
                <p class="small text-muted mb-0">
                  Turbine casing and foundation bolts.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-anchor"></i>
                </div>
                <h4>Subsea</h4>
                <p class="small text-muted mb-0">
                  Pipeline tie-ins and riser clamps.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-lg-6">
              <h2 class="mb-4 fw-bold">Why Choose Velcorix?</h2>
              <div class="bg-white p-4 rounded shadow-sm">
                <p class="text-muted">
                  We combine advanced tooling with expert calculation software to
                  eliminate guesswork and ensure joint integrity.
                </p>
                <ul class="list-unstyled">
                  <li class="mb-3 d-flex align-items-start">
                    <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                    <div>
                      <strong>Certified Accuracy:</strong> All torque wrenches and
                      pumps are calibrated to international standards (NIST
                      traceable).
                    </div>
                  </li>
                  <li class="mb-3 d-flex align-items-start">
                    <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                    <div>
                      <strong>Engineering Support:</strong> We calculate precise
                      torque values and pump pressures based on friction factors,
                      bolt grade, and temperature.
                    </div>
                  </li>
                  <li class="mb-3 d-flex align-items-start">
                    <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                    <div>
                      <strong>Zero Leaks:</strong> Strict adherence to ASME PCC-1
                      guidelines and multi-pass tightening sequences (Star
                      Pattern).
                    </div>
                  </li>
                </ul>
              </div>
            </div>
            <div class="col-lg-6">
              <img src="/assets/images/services/bolt-torque.jpg" alt="Bolting Capabilities" class="img-fluid rounded shadow w-100" onerror="
                  this.src = 'https://placehold.co/600x400?text=Expert+Bolting'
                ">
            </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Compliance &amp; Standards</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-scroll text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">ASME PCC-1</h6>
                <p class="small text-muted mb-0">
                  Full compliance with Guidelines for Pressure Boundary Bolted
                  Flange Joint Assembly.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-user-graduate text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">ECITB Certified</h6>
                <p class="small text-muted mb-0">
                  Technicians trained and certified to ECITB MJI standards.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-alt text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Reporting</h6>
                <p class="small text-muted mb-0">
                  Comprehensive joint completion reports for QA/QC.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Safety First</h6>
                <p class="small text-muted mb-0">
                  Rigorous inspection of high-pressure hoses and pumps.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Secure Your Connections</h2>
          <p class="cta-subtext">
            Trust Velcorix for proven bolt torquing and tensioning expertise.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Get a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
