---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Hot Tapping - Velcorix Services",
  description: "Safe and efficient hot tapping and line stopping services for live pipelines in UAE. Velcorix enables modifications and tie-ins without system shutdowns or product loss.",
  canonical: "https://www.velcorix.com/services/hot-tapping.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Hot Tapping Services",
      "description": "Safe and efficient hot tapping and line stopping services for live pipelines in UAE. Velcorix enables modifications and tie-ins without system shutdowns or product loss.",
      "serviceType": "Hot Tapping Services",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/services/hot-tapping.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Hot Tapping Services",
          "item": "https://www.velcorix.com/services/hot-tapping.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/services/DSC_2341.JPG');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Hot Tapping Services</h1>
          <p class="lead">Live Pipeline Intervention without Shutdown</p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/services/DSC_2345.JPG" class="img-fluid shadow intro-image" alt="Hot Tapping" onerror="this.src='https://placehold.co/800x400?text=Hot+Tapping'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Keep the Flow Going</h2>
              <p>
                In today's continuously operating industrial facilities, shutting down a pipeline for modifications is often not an option. Hot tapping (under-pressure drilling) allows for new tie-ins to be made while the system remains in full operation.
              </p>
              <p>
                Velcorix provides world-class hot tapping and line stopping services, enabling clients to expand, repair, or modify piping systems without service interruption, product loss, or environmental risk.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Scope / What’s Included</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Hot Tapping</h5>
                  <p class="text-muted mb-0">Drilling into pressurized pipes ranging from 1/2" to 42" diameter.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Line Stopping</h5>
                  <p class="text-muted mb-0">Temporary isolation of pipeline sections for valve replacement or repair.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Fittings Supply</h5>
                  <p class="text-muted mb-0">Provision of split tees, weldolets, and sandwich valves.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Engineering Study</h5>
                  <p class="text-muted mb-0">Feasibility analysis including flow rate and wall thickness verification.</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-project-diagram"></i>
                </div>
                <h4>New Tie-Ins</h4>
                <p class="small text-muted mb-0">
                  Adding branch connections for plant expansions.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-thermometer-half"></i>
                </div>
                <h4>Probe Insert</h4>
                <p class="small text-muted mb-0">
                  Installing thermowells or sample probes on live lines.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-wrench"></i>
                </div>
                <h4>Valve Change</h4>
                <p class="small text-muted mb-0">
                  Isolating sections to replace defective mainline valves.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-fire-extinguisher"></i>
                </div>
                <h4>Fire Loops</h4>
                <p class="small text-muted mb-0">
                   Extending fire water networks without system drainage.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Capability Details</h2>
                  <div class="bg-white p-4 rounded shadow-sm">
                     <p class="text-muted">
                      Precision is paramount when drilling into live hydrocarbon or chemical lines.
                     </p>
                     <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                          <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                          <div>
                            <strong>Versatility:</strong> Capabilities for carbon steel, stainless steel, and ductile iron pipes.
                          </div>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Conditions:</strong> Equipment rated for temperatures up to 370°C and pressures up to 1480 psi.
                           </div>
                         </li>
                         <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Orientation:</strong> Ability to tap vertically, horizontally, or at any angle required by site constraints.
                           </div>
                         </li>
                     </ul>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/services/DSC_2359.JPG" alt="Hot Tapping Expertise" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Hot+Tapping+Expertise'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance Standards</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-book-reader text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">API 2201</h6>
                  <p class="small text-muted mb-0">Procedures for Welding or Hot Tapping on Equipment.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-user-shield text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Experienced Crews</h6>
                  <p class="small text-muted mb-0">Technicians with minimum 5 years specific hot tap experience.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">WPS/PQR</h6>
                  <p class="small text-muted mb-0">Qualified welding procedures for in-service welding.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Avoid Shutdowns</h2>
          <p class="cta-subtext">
            Keep your plant running while we make the connections.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Get Hot Tapping Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
