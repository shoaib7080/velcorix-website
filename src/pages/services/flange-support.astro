---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Flange Management & Support - Velcorix Services",
  description: "Expert flange management and technical support in UAE. Velcorix provides systematic joint tracking, tagging, and traceability for leak-free industrial facilities.",
  canonical: "https://www.velcorix.com/services/flange-support.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Flange Management & Support",
      "description": "Expert flange management and technical support in UAE. Velcorix provides systematic joint tracking, tagging, and traceability for leak-free industrial facilities.",
      "serviceType": "Flange Management & Support",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/services/flange-support.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Flange Management & Support",
          "item": "https://www.velcorix.com/services/flange-support.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../images/service/service-8.jpg');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Flange Management &amp; Support</h1>
          <p class="lead">Systematic Joint Integrity Assurance Solutions</p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/images/background/about-1.jpg" class="img-fluid shadow intro-image" alt="Flange Management Support" onerror="this.src='https://placehold.co/800x400?text=Management+Support'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Zero Leaks, Total Control</h2>
              <p>
                Effective flange management goes beyond just tightening bolts. It involves a systematic approach to identifying, tracking, and verifying every critical joint in your facility. Velcorix provides comprehensive management and technical support services to ensure absolute joint integrity.
              </p>
              <p>
                From the initial tagging of flanges to the final handover of a leak-free system, our engineering teams manage the entire process, providing you with full traceability and peace of mind.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Scope / What’s Included</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Database Management</h5>
                  <p class="text-muted mb-0">Use of specialized software to log joint details and status.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Tagging System</h5>
                  <p class="text-muted mb-0">Physical identification of joints to track progress (assembled, tightened, tested).</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Work Pack Generation</h5>
                  <p class="text-muted mb-0">Creation of detailed instruction sheets for field technicians.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">QA/QC Handover</h5>
                  <p class="text-muted mb-0">Compilation of final joint completion certificates for startup.</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-sync"></i>
                </div>
                <h4>Turnarounds</h4>
                <p class="small text-muted mb-0">
                  Managing thousands of joints during time-critical shutdowns.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-hard-hat"></i>
                </div>
                <h4>Construction</h4>
                <p class="small text-muted mb-0">
                  Tracking joint progress during new plant erection.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-clipboard-check"></i>
                </div>
                <h4>Audits</h4>
                <p class="small text-muted mb-0">
                  Verifying compliance of existing systems to new standards.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h4>Leak Investigations</h4>
                <p class="small text-muted mb-0">
                   Root cause analysis of failed joints.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Capability Details</h2>
                  <div class="bg-white p-4 rounded shadow-sm">
                     <p class="text-muted">
                      Our technical support team acts as the brain behind the muscle of the bolting crews.
                     </p>
                     <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                          <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                          <div>
                            <strong>Software Integration:</strong> We utilize industry-leading flange management software to calculate torque values and track status.
                          </div>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Engineering Review:</strong> Review of client piping specifications to select correct gaskets, bolts, and lubricants.
                           </div>
                         </li>
                         <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>On-Site Supervision:</strong> Deployment of subject matter experts to guide technicians and resolve queries instantly.
                           </div>
                         </li>
                     </ul>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/images/background/award-1.jpg" alt="Support Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Support+Capabilities'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-book text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Procedures</h6>
                  <p class="small text-muted mb-0">Development of site-specific bolting procedures.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-chart-line text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Progress Tracking</h6>
                  <p class="small text-muted mb-0">Daily reports on percentage completion and leak test readiness.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-chalkboard-teacher text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Training</h6>
                  <p class="small text-muted mb-0">On-site toolbox talks and best practice coaching.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Manage Your Integrity</h2>
          <p class="cta-subtext">
            Ensure a seamless startup with Velcorix's Flange Management Support.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Consult Our Experts</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
