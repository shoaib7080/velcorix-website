---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "EPC Services - Velcorix",
  description: "Premier EPC services for Oil & Gas, Petrochemical, and Power industries in the UAE. Turnkey Engineering, Procurement, and Construction solutions focusing on safety and operational excellence.",
  canonical: "https://www.velcorix.com/services/epc.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "EPC Services",
      "description": "Premier EPC services for Oil & Gas, Petrochemical, and Power industries in the UAE. Turnkey Engineering, Procurement, and Construction solutions focusing on safety and operational excellence.",
      "serviceType": "EPC Services",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/services/epc.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "EPC Services",
          "item": "https://www.velcorix.com/services/epc.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/services/DSC_2341.JPG');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">EPC Services</h1>
          <p class="lead">
            Engineering, Procurement, and Construction Excellence
          </p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/services/DSC_2454.JPG" class="img-fluid shadow intro-image" alt="EPC Services" onerror="this.src='https://placehold.co/800x400?text=EPC+Services'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Integrated EPC Solutions</h2>
              <p>
                Velcorix delivers high-impact Engineering, Procurement, and Construction (EPC) solutions designed to meet the rigorous demands of the Oil &amp; Gas, Petrochemical, and Power sectors. We provide end-to-end project lifecycle management—from initial feasibility and Front-End Engineering Design (FEED) to final commissioning and handover.
              </p>
              <p>
                Our integrated delivery model optimizes project schedules, minimizes risk, and ensures capital efficiency for complex brownfield and greenfield developments across the UAE and the region.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Offerings</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Multi-Disciplinary Engineering</h5>
                  <p class="text-muted mb-0">Comprehensive FEED and Detailed Engineering services enhancing constructability.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Global Procurement</h5>
                  <p class="text-muted mb-0">Strategic sourcing, expediting, and material management with strict QA/QC.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Construction Execution</h5>
                  <p class="text-muted mb-0">Safe and efficient civil, mechanical, and E&amp;I construction services.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Commissioning Support</h5>
                  <p class="text-muted mb-0">Structured pre-commissioning, functional testing, and startup assistance.</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Applicable Projects</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-oil-well"></i>
                </div>
                <h4>Upstream Oil &amp; Gas</h4>
                <p class="small text-muted mb-0">
                  Wellhead tie-ins and gathering stations.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-industry"></i>
                </div>
                <h4>Refineries</h4>
                <p class="small text-muted mb-0">
                  Process unit upgrades and expansion projects.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-burn"></i>
                </div>
                <h4>Petrochemical</h4>
                <p class="small text-muted mb-0">
                  Plant modifications and reliability improvements.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-water"></i>
                </div>
                <h4>Utilities</h4>
                <p class="small text-muted mb-0">
                  Water treatment and power distribution infrastructure.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Capability Details</h2>
                  <div class="bg-white p-4 rounded shadow-sm">
                     <p class="text-muted">
                      Our execution strategy is built on a value assurance process that ensures control and visibility at every stage.
                     </p>
                     <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                          <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                          <div>
                            <strong>Engineering:</strong> Delivering precise Front-End Engineering Design (FEED) and detailed engineering packages focused on safety and constructability.
                          </div>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Procurement:</strong> Leveraging a global network of approved manufacturers to secure high-specification materials and equipment on schedule.
                           </div>
                         </li>
                         <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Construction:</strong> Implementing rigorous HSE protocols and quality control measures to deliver projects safely and to specification.
                           </div>
                         </li>
                     </ul>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/services/DSC_2456.JPG" alt="EPC Execution" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Execution+Capabilities'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Safety First</h6>
                  <p class="small text-muted mb-0">Adherence to international HSE standards (ISO 45001) is non-negotiable.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-certificate text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Quality Assurance</h6>
                  <p class="small text-muted mb-0">ISO 9001 certified processes for deliverables and documentation.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-drafting-compass text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Design Compliance</h6>
                  <p class="small text-muted mb-0">Designs meet API, ASME, and local regulatory codes.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-users-cog text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Dedicated PM</h6>
                  <p class="small text-muted mb-0">Single point of contact project management for streamlined communication.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Partner for Success</h2>
          <p class="cta-subtext">
            Trust Velcorix with your next critical EPC project.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Consultation</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
