---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Lifting Manpower - Velcorix Services",
  description: "Certified lifting manpower in UAE. Velcorix supplies third-party certified riggers, crane operators, and lifting supervisors for safe heavy lifting operations.",
  canonical: "https://www.velcorix.com/services/manpower-lifting.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Lifting Manpower",
      "description": "Certified lifting manpower in UAE. Velcorix supplies third-party certified riggers, crane operators, and lifting supervisors for safe heavy lifting operations.",
      "serviceType": "Lifting Manpower",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/services/manpower-lifting.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Lifting Manpower",
          "item": "https://www.velcorix.com/services/manpower-lifting.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../images/service/service-8.jpg');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Lifting Manpower</h1>
          <p class="lead">Certified Riggers and Operators for Heavy Lifts</p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/images/background/about-1.jpg" class="img-fluid shadow intro-image" alt="Lifting Manpower" onerror="this.src='https://placehold.co/800x400?text=Lifting+Manpower'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Raising Standards in Lifting Operations</h2>
              <p>
                Safe lifting operations depend heavily on the competence of the personnel involved. Velcorix supplies third-party certified riggers, banksmen, and crane operators who are trained to handle complex lifts with precision and safety.
              </p>
              <p>
                Whether it's a tandem lift or a confined space hoisting operation, our team ensures every movement is calculated and controlled.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Scope / What’s Included</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Lifting Supervisors</h5>
                  <p class="text-muted mb-0">Appointed Persons (AP) for planning and overseeing lifts.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Riggers (Level 1, 2, 3)</h5>
                  <p class="text-muted mb-0">Competent crew for slinging and signaling.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Crane Operators</h5>
                  <p class="text-muted mb-0">Licensed operators for mobile, crawler, and tower cranes.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Rigging Inspectors</h5>
                  <p class="text-muted mb-0">Qualified to inspect lifting gear before use.</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-truck-loading"></i>
                </div>
                <h4>Equipment Installation</h4>
                <p class="small text-muted mb-0">
                  Positioning of skids and heavy machinery.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-building"></i>
                </div>
                <h4>Steel Erection</h4>
                <p class="small text-muted mb-0">
                  Structural steel lifting for construction.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-ship"></i>
                </div>
                <h4>Marine Lifting</h4>
                <p class="small text-muted mb-0">
                  Loading and unloading supply vessels.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-random"></i>
                </div>
                <h4>Complex Lifts</h4>
                <p class="small text-muted mb-0">
                   Tandem lifts requiring coordinated crane operation.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Capability Details</h2>
                  <div class="bg-white p-4 rounded shadow-sm">
                     <p class="text-muted">
                      We maintain a rigorous standard for all lifting personnel to mitigate the risks associated with suspended loads.
                     </p>
                     <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                          <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                          <div>
                            <strong>Certification:</strong> All personnel hold valid TPI or international agency cards.
                          </div>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Planning:</strong> Supervisors capable of creating detailed Lift Plans and Risk Assessments.
                           </div>
                         </li>
                         <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Communication:</strong> Standardized hand signals and radio protocols for clear direction.
                           </div>
                         </li>
                     </ul>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/images/background/award-1.jpg" alt="Lifting Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Lifting+Capabilities'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance Standards</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">LOLER</h6>
                  <p class="small text-muted mb-0">Compliance with Lifting Operations and Lifting Equipment Regulations.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-id-badge text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Competency</h6>
                  <p class="small text-muted mb-0">Verifiable training records for every crew member.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">PPE</h6>
                  <p class="small text-muted mb-0">Standard Issue: High-vis, safety boots, and hard hats.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Heavy Lifting Made Safe</h2>
          <p class="cta-subtext">
            Trust Velcorix's certified riggers for your critical lifts.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Hire Lifting Crew</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
