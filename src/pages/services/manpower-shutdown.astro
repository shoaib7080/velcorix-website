---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Shutdown Manpower - Velcorix Services",
  description: "Skilled shutdown and turnaround manpower in UAE. Velcorix provides experienced supervisors, technicians, and safety personnel for efficient industrial plant outages.",
  canonical: "https://www.velcorix.com/services/manpower-shutdown.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Shutdown Manpower",
      "description": "Skilled shutdown and turnaround manpower in UAE. Velcorix provides experienced supervisors, technicians, and safety personnel for efficient industrial plant outages.",
      "serviceType": "Shutdown Manpower",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/services/manpower-shutdown.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Shutdown Manpower",
          "item": "https://www.velcorix.com/services/manpower-shutdown.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/services/DSC_2412.JPG');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Shutdown Manpower</h1>
          <p class="lead">Experienced Workforce for Turnaround Projects</p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/services/DSC_2418.JPG" class="img-fluid shadow intro-image" alt="Shutdown Manpower" onerror="this.src='https://placehold.co/800x400?text=Shutdown+Manpower'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Skilled Hands, Safe Execution</h2>
              <p>
                Plant shutdowns and turnarounds are high-pressure events where every hour counts. Velcorix alleviates the stress of staffing by providing highly skilled, vetted, and safety-conscious manpower.
              </p>
              <p>
                From multi-disciplinary supervisors to hands-on technicians, our workforce is experienced in the unique challenges of shutdown environments, ensuring efficient execution and a safe return to operation.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Scope / What’s Included</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Supervisors &amp; Foremen</h5>
                  <p class="text-muted mb-0">Experienced leaders offering mechanical, electrical, and civil oversight.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Mechanical Technicians</h5>
                  <p class="text-muted mb-0">Fitters, fabricators, and millwrights for equipment overhaul.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Certified Welders</h5>
                  <p class="text-muted mb-0">Code-qualified welders (ASME IX, AWS) for pipe and structural repairs.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Safety Personnel</h5>
                  <p class="text-muted mb-0">HSE officers and fire watchers to maintain site safety.</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-calendar-times"></i>
                </div>
                <h4>Scheduled Outages</h4>
                <p class="small text-muted mb-0">
                  Planned maintenance for refineries and power plants.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-exclamation-circle"></i>
                </div>
                <h4>Emergency Shut</h4>
                <p class="small text-muted mb-0">
                  Rapid mobilization of repair crews for unplanned failures.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-tools"></i>
                </div>
                <h4>Valve Overhaul</h4>
                <p class="small text-muted mb-0">
                  Specialized teams for control valve and relief valve servicing.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-exchange-alt"></i>
                </div>
                <h4>Exchanger Retubing</h4>
                <p class="small text-muted mb-0">
                   Crews dedicated to heat exchanger bundle maintenance.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Capability Details</h2>
                  <div class="bg-white p-4 rounded shadow-sm">
                     <p class="text-muted">
                      We don't just supply bodies; we supply competence. Our recruitment and vetting process ensures high-quality output.
                     </p>
                     <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                          <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                          <div>
                            <strong>Rapid Mobilization:</strong> A large database of pre-screened candidates ready for deployment.
                          </div>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Visa &amp; Logistics:</strong> Full handling of visas, accommodation, and transport for the workforce.
                           </div>
                         </li>
                         <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Compliance:</strong> Strict adherence to local labor laws and site-specific medical/safety requirements.
                           </div>
                         </li>
                     </ul>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/services/DSC_2341.JPG" alt="Manpower Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Manpower+Capabilities'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-id-card text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Background Checks</h6>
                  <p class="small text-muted mb-0">Thorough screening of qualifications and experience.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-user-md text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Medical Fitness</h6>
                  <p class="small text-muted mb-0">Fit-to-work certifications for all deployed personnel.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Safety Inductions</h6>
                  <p class="small text-muted mb-0">Pre-deployment H2S and safety training.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Staff Up for Success</h2>
          <p class="cta-subtext">
            Secure the best talent for your next shutdown with Velcorix.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Get Manpower Support</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
