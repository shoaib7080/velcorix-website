---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Oil & Gas Upstream/Downstream - Velcorix Services",
  description: "Comprehensive upstream and downstream oil & gas services in UAE. Velcorix provides end-to-end solutions from wellhead maintenance to refinery turnarounds.",
  canonical: "https://www.velcorix.com/services/upstream-downstream.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Oil & Gas Upstream/Downstream",
      "description": "Comprehensive upstream and downstream oil & gas services in UAE. Velcorix provides end-to-end solutions from wellhead maintenance to refinery turnarounds.",
      "serviceType": "Oil & Gas Upstream/Downstream",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/services/upstream-downstream.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Oil & Gas Upstream/Downstream",
          "item": "https://www.velcorix.com/services/upstream-downstream.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background:
            linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url(&quot;../assets/images/services/DSC_2482.JPG&quot;);
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Oil &amp; Gas Upstream/Downstream</h1>
          <p class="lead">
            Integrated Solutions for the Entire Energy Value Chain
          </p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/services/DSC_2493.JPG" class="img-fluid shadow intro-image" alt="Upstream &amp; Downstream Services" onerror="
                  this.src =
                    'https://placehold.co/800x400?text=Integrated+Services'
                ">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Comprehensive Energy Support</h2>
              <p>
                Velcorix delivers end-to-end expertise across the Oil &amp; Gas
                sector, continuously supporting operations from the wellhead to
                the refinery. By merging upstream field development with
                downstream processing support, we ensure seamless asset integrity
                and operational efficiency.
              </p>
              <p>
                <strong>Upstream:</strong> We optimize exploration and production
                with rapid-response equipment rentals, wellhead maintenance, and
                skilled manpower for remote field operations.
              </p>
              <p>
                <strong>Downstream:</strong> Our team ensures profitability in
                refining and gathering through specialized turnarounds, tank
                maintenance, and catalyst handling services.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Specialized Capabilities</h2>
          </div>

          <!-- Upstream Block -->
          <h4 class="mb-4 text-primary fw-bold border-bottom pb-2 d-inline-block">
            Upstream Capabilities
          </h4>
          <div class="row g-4 mb-5">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Wellhead Maintenance</h5>
                  <p class="text-muted mb-0">
                    Routine inspection, greasing, and valve integrity checks to
                    prevent leaks and downtime.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Drilling &amp; Seismic Support</h5>
                  <p class="text-muted mb-0">
                    Logistics, campsite preparation, and auxiliary manpower for
                    seismic surveys and drilling rigs.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Field Development</h5>
                  <p class="text-muted mb-0">
                    Early Production Facility (EPF) support and rapid deployment
                    of power and compression rentals.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Downstream Block -->
          <h4 class="mb-4 text-primary fw-bold border-bottom pb-2 d-inline-block">
            Downstream Capabilities
          </h4>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Refinery Turnarounds</h5>
                  <p class="text-muted mb-0">
                    Comprehensive planning, manpower, and mechanical services for
                    plant shutdowns (TAR).
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Tank &amp; Vessel Services</h5>
                  <p class="text-muted mb-0">
                    API 653 tank inspections, cleaning, and repairs, including
                    confined space entry.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Catalyst Handling</h5>
                  <p class="text-muted mb-0">
                    Expert loading and unloading of reactor catalysts under inert
                    or atmospheric conditions.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Piping &amp; Mechanical</h5>
                  <p class="text-muted mb-0">
                    Fabrication, spool replacement, and hot tapping support for
                    process piping.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Applied Across the Value Chain</h2>
          </div>
          <div class="row g-4">
            <!-- Upstream Icons -->
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-oil-well"></i>
                </div>
                <h4>Onshore Rigs</h4>
                <p class="small text-muted mb-0">
                  Drilling rig and workover support.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-map-marked-alt"></i>
                </div>
                <h4>Exploration</h4>
                <p class="small text-muted mb-0">
                  Remote survey logistics &amp; camps.
                </p>
              </div>
            </div>
            <!-- Downstream Icons -->
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-industry"></i>
                </div>
                <h4>Refineries</h4>
                <p class="small text-muted mb-0">
                  Process unit updates &amp; maintenance.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-gas-pump"></i>
                </div>
                <h4>Terminals</h4>
                <p class="small text-muted mb-0">
                  Storage &amp; loading arm repairs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-lg-6">
              <h2 class="mb-4 fw-bold">Why Velcorix?</h2>
              <div class="bg-white p-4 rounded shadow-sm">
                <p class="text-muted">
                  We bridge the gap between extraction and production, offering a
                  unified standard of safety and quality wherever we operate.
                </p>
                <ul class="list-unstyled">
                  <li class="mb-3 d-flex align-items-start">
                    <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                    <div>
                      <strong>Rapid Mobilization:</strong> Whether it's a remote
                      desert wellhead or a coastal refinery, our teams deploy
                      24/7.
                    </div>
                  </li>
                  <li class="mb-3 d-flex align-items-start">
                    <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                    <div>
                      <strong>Integrated Services:</strong> One partner for
                      mechanical, electrical, and instrumentation tailored to both
                      upstream and downstream needs.
                    </div>
                  </li>
                  <li class="mb-3 d-flex align-items-start">
                    <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                    <div>
                      <strong>HSE Excellence:</strong> Uniform safety protocols
                      (ISO 45001) covering H2S awareness, confined space entry,
                      and defensive driving.
                    </div>
                  </li>
                </ul>
              </div>
            </div>
            <div class="col-lg-6">
              <img src="/assets/images/services/DSC_2335.JPG" alt="Integrated Capabilities" class="img-fluid rounded shadow w-100" onerror="
                  this.src =
                    'https://placehold.co/600x400?text=Integrated+Support'
                ">
            </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Compliance &amp; Standards</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Zero Harm</h6>
                <p class="small text-muted mb-0">
                  HSE focus across all upstream/downstream sites.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-certificate text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">API Standards</h6>
                <p class="small text-muted mb-0">
                  Adherence to API 653, 510, and 570 codes.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-signature text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">PTW Compliant</h6>
                <p class="small text-muted mb-0">
                  Strict management of multi-client Permit to Work systems.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-globe text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Logistics</h6>
                <p class="small text-muted mb-0">
                  Expert movement of heavy equipment in difficult terrains.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Streamline Your Operations</h2>
          <p class="cta-subtext">
            From the field to the facility, trust Velcorix for integrated support.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Contact Our Team</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
