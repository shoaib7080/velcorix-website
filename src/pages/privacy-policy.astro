---
import BaseLayout from "../layouts/BaseLayout.astro";

const meta = {
  title: "Privacy Policy - Velcorix",
  description: "How the Velcorix website collects and handles information, including messages sent to the website assistant.",
  canonical: "https://www.velcorix.com/privacy-policy.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Privacy Policy",
          "item": "https://www.velcorix.com/privacy-policy.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Page Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background:
            linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url(&quot;assets/images/hero/DSC_2378.JPG&quot;);
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Privacy Policy</h1>
          <p class="lead">
            What information this website collects, and what happens to it.
          </p>
        </div>
      </header>

      <!-- Main Content -->
      <section class="section-padding">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-lg-9">
              <p class="text-muted">Last updated: 4 August 2026</p>

              <h2 class="mt-4 mb-3">Who we are</h2>
              <p>
                Velcorix is a mechanical trading and consultancy firm based in
                Dubai, United Arab Emirates, providing oil and gas services,
                industrial equipment rentals, shutdown management and EPC
                advisory. This policy covers the website at www.velcorix.com.
              </p>
              <!-- TODO: add the registered company name and full registered address here before this is treated as final. -->
              <p>
                If you have any question about this policy, or about information
                we hold about you, write to
                <a href="mailto:info@velcorix.com">info@velcorix.com</a>.
              </p>

              <h2 class="mt-5 mb-3">What we collect</h2>
              <p>We collect three kinds of information, and no more than that.</p>
              <ul>
                <li class="mb-2">
                  <strong>What you send us through the contact form.</strong> Your
                  name, email address, phone number and the message you write. You
                  choose what to put in it.
                </li>
                <li class="mb-2">
                  <strong>What you type into the website assistant.</strong> The
                  chat window on this site records the messages you send it so it
                  can reply. See the section below, because those messages leave
                  our website.
                </li>
                <li class="mb-2">
                  <strong>Basic technical information.</strong> Your IP address,
                  browser type and the pages you visit. Our hosting provider
                  records this automatically, and we use your IP address to limit
                  how many chat messages can be sent in a short period, which
                  stops the assistant being abused.
                </li>
              </ul>
              <p>
                We do not ask for, and this website has no way to collect, payment
                card details, passport or Emirates ID numbers, or any other
                identity documents.
              </p>

              <h2 class="mt-5 mb-3">The website assistant and Google</h2>
              <p>
                The chat window on this site is powered by Google's Gemini API.
                This matters, so we want to be plain about it:
                <strong>
                  the messages you type into that window are sent to Google to
                  generate a reply.
                </strong>
                They are processed on Google's systems, which are located outside
                the United Arab Emirates, and are subject to Google's own terms
                and privacy practices in addition to this policy.
              </p>
              <p>
                Because of that, please do not type anything confidential,
                commercially sensitive, or personal about yourself or anyone else
                into the chat window. It is there to answer general questions
                about our services and equipment. For anything specific — a
                quotation, a technical requirement, a project detail — use the
                <a href="/contact.html">contact page</a>, WhatsApp, or email, where
                your message comes to us directly.
              </p>
              <p>
                We do not use anything typed into the assistant to build a profile
                of you, and we do not connect it to your contact form submissions.
              </p>

              <h2 class="mt-5 mb-3">Why we use your information</h2>
              <ul>
                <li class="mb-2">To answer your enquiry and provide a quotation.</li>
                <li class="mb-2">
                  To supply the services or equipment you ask about, and to
                  communicate with you about them.
                </li>
                <li class="mb-2">
                  To keep the website working, secure, and free from abuse.
                </li>
                <li class="mb-2">
                  To meet legal and regulatory obligations that apply to us.
                </li>
              </ul>
              <p>
                We do not sell your information. We do not share it with anyone for
                their own marketing.
              </p>

              <h2 class="mt-5 mb-3">Who else handles your information</h2>
              <p>
                We use a small number of service providers to run this website.
                Each of them may process some of the information described above:
              </p>
              <ul>
                <li class="mb-2">
                  <strong>Google</strong> — provides the Gemini API that powers the
                  website assistant, as described above.
                </li>
                <li class="mb-2">
                  <strong>Vercel</strong> — hosts this website and records standard
                  server logs, including IP addresses.
                </li>
                <li class="mb-2">
                  <strong>Zoho</strong> — provides our email, so messages you send
                  us are stored there.
                </li>
                <li class="mb-2">
                  <strong>Content delivery networks</strong> — this site loads
                  fonts, styling and icons from Google Fonts, jsDelivr and
                  Cloudflare. Your browser contacts them directly, so they receive
                  your IP address.
                </li>
                <li class="mb-2">
                  <strong>Meta</strong> — if you choose to click the WhatsApp
                  button, you are taken to WhatsApp and your conversation there is
                  governed by WhatsApp's own privacy policy.
                </li>
              </ul>
              <p>
                Several of these providers operate servers outside the United Arab
                Emirates, so using this website involves your information being
                transferred abroad.
              </p>

              <h2 class="mt-5 mb-3">Cookies</h2>
              <p>
                This website does not set cookies of its own, and there is no
                advertising or tracking on it. The third-party services listed
                above may set cookies of their own when your browser contacts
                them. You can block or delete cookies in your browser settings;
                the site will still work.
              </p>
              <p>
                If we add website analytics in future, we will update this policy
                before doing so.
              </p>

              <h2 class="mt-5 mb-3">How long we keep it</h2>
              <p>
                Enquiries and the correspondence that follows are kept for as long
                as we are dealing with you, and afterwards for as long as we need
                them for our business records or to meet a legal obligation.
                Server logs are kept for a short period only. Chat messages are
                not stored on our systems after the conversation ends — closing
                the chat window clears it.
              </p>

              <h2 class="mt-5 mb-3">Your rights</h2>
              <p>
                Under the United Arab Emirates Personal Data Protection Law
                (Federal Decree-Law No. 45 of 2021) you may ask us to:
              </p>
              <ul>
                <li class="mb-2">tell you what information we hold about you;</li>
                <li class="mb-2">correct it if it is wrong or incomplete;</li>
                <li class="mb-2">delete it, where we have no reason to keep it;</li>
                <li class="mb-2">
                  stop using it for a particular purpose, or withdraw a consent you
                  have given;
                </li>
                <li class="mb-2">provide it in a portable form.</li>
              </ul>
              <p>
                To exercise any of these, email
                <a href="mailto:info@velcorix.com">info@velcorix.com</a>. We will
                respond as soon as we reasonably can. If you are contacting us from
                outside the UAE, tell us and we will handle your request under the
                rules that apply to you.
              </p>

              <h2 class="mt-5 mb-3">Security</h2>
              <p>
                This website is served over an encrypted connection, and access to
                enquiries we receive is limited to the people at Velcorix who need
                it. No website can promise perfect security, which is another
                reason not to send sensitive documents or identity details through
                this site.
              </p>

              <h2 class="mt-5 mb-3">Children</h2>
              <p>
                This website is aimed at businesses and is not intended for
                children. We do not knowingly collect information about anyone
                under 18.
              </p>

              <h2 class="mt-5 mb-3">Changes to this policy</h2>
              <p>
                If we change how this website handles information, we will update
                this page and change the date at the top. Where the change is
                significant, we will say so clearly rather than quietly amend it.
              </p>

              <h2 class="mt-5 mb-3">Contact</h2>
              <p>
                Velcorix<br>
                Dubai, United Arab Emirates<br>
                <a href="mailto:info@velcorix.com">info@velcorix.com</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Questions About Your Information?</h2>
          <p class="cta-subtext">
            Get in touch and we will answer them properly.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Contact Us</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
