---
import BaseLayout from "../layouts/BaseLayout.astro";

const meta = {
  title: "Terms & Conditions - Velcorix",
  description: "The terms on which you may use the Velcorix website, including the limits of the website assistant.",
  canonical: "https://www.velcorix.com/terms-and-conditions.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Terms & Conditions",
          "item": "https://www.velcorix.com/terms-and-conditions.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Page Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background:
            linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url(&quot;assets/images/hero/DSC_2378.JPG&quot;);
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Terms &amp; Conditions</h1>
          <p class="lead">The terms on which you may use this website.</p>
        </div>
      </header>

      <!-- Main Content -->
      <section class="section-padding">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-lg-9">
              <p class="text-muted">Last updated: 4 August 2026</p>

              <h2 class="mt-4 mb-3">These terms</h2>
              <p>
                This website is operated by Velcorix, a mechanical trading and
                consultancy firm based in Dubai, United Arab Emirates. By using
                the site you accept these terms. If you do not accept them, please
                do not use the site.
              </p>
              <!-- TODO: add the registered company name and full registered address here before this is treated as final. -->

              <h2 class="mt-5 mb-3">Using this website</h2>
              <p>
                You may use this website to learn about our services and equipment
                and to get in touch with us. You may not use it to do anything
                unlawful, to attempt to gain access to systems or data you are not
                entitled to, to interfere with how the site works for others, or to
                extract its contents in bulk by automated means.
              </p>

              <h2 class="mt-5 mb-3">Information on this site is indicative</h2>
              <p>
                We describe our services, equipment and capabilities in good faith
                and keep the site up to date as best we can. Even so, everything
                here is general information rather than a commitment.
                Specifications, equipment availability, timescales and capabilities
                vary by project and can change without notice.
              </p>
              <p>
                <strong>Nothing on this website is an offer to contract.</strong>
                No price, availability or specification shown or discussed here
                binds us. Anything you rely on commercially should be confirmed
                with our team in writing first.
              </p>

              <h2 class="mt-5 mb-3">The website assistant</h2>
              <p>
                The chat window on this site is an automated assistant powered by
                artificial intelligence. It is there to point you in the right
                direction, and it is genuinely useful for that. But it generates
                its answers automatically, and like any such system it can be
                incomplete, out of date, or simply wrong.
              </p>
              <p>
                Please treat what it says as a starting point rather than an
                answer you can act on. It cannot give you a price, confirm that
                equipment is available, commit to a delivery date, or provide
                technical or engineering advice for your situation — and where it
                appears to, that carries no weight. Anything that matters should be
                confirmed with a person at Velcorix, and only a written quotation
                or agreement from us is binding.
              </p>
              <p>
                Please also avoid typing confidential or personal information into
                the chat window. Our
                <a href="/privacy-policy.html">Privacy Policy</a> explains where
                those messages go.
              </p>

              <h2 class="mt-5 mb-3">Quotations and contracts</h2>
              <p>
                Any work we carry out for you, and any equipment we supply or rent,
                is governed by the quotation, purchase order, rental agreement or
                contract agreed between us in writing. Those documents set out the
                commercial terms, and they take precedence over anything on this
                website.
              </p>

              <h2 class="mt-5 mb-3">Intellectual property</h2>
              <p>
                The content of this website — text, photographs, graphics, layout
                and the Velcorix name and logo — belongs to Velcorix or is used
                with permission. You may view it, and print or share pages for your
                own business purposes. You may not republish it, use it
                commercially, or present it as your own without our written
                permission.
              </p>

              <h2 class="mt-5 mb-3">Links to other sites</h2>
              <p>
                This website links to services we do not control, including
                WhatsApp. We are not responsible for their content or their
                practices, and a link is not an endorsement. When you follow one,
                that provider's own terms and privacy policy apply.
              </p>

              <h2 class="mt-5 mb-3">Availability</h2>
              <p>
                We aim to keep this website available, but we do not guarantee it.
                It may be unavailable at times for maintenance, or for reasons
                outside our control. We may change, suspend or withdraw any part
                of it without notice.
              </p>

              <h2 class="mt-5 mb-3">Our liability</h2>
              <p>
                To the fullest extent permitted by law, we are not liable for any
                loss arising from your use of this website or from reliance on
                anything published on it, including anything generated by the
                website assistant. This does not limit any liability that cannot be
                excluded under the law of the United Arab Emirates, and it does not
                affect obligations we owe you under a contract we have actually
                entered into with you.
              </p>

              <h2 class="mt-5 mb-3">Changes to these terms</h2>
              <p>
                We may update these terms from time to time. The version published
                here, with the date shown at the top, is the one that applies.
              </p>

              <h2 class="mt-5 mb-3">Governing law</h2>
              <p>
                These terms are governed by the laws of the United Arab Emirates,
                and the courts of Dubai have jurisdiction over any dispute arising
                from them.
              </p>

              <h2 class="mt-5 mb-3">Contact</h2>
              <p>
                Velcorix<br>
                Dubai, United Arab Emirates<br>
                <a href="mailto:info@velcorix.com">info@velcorix.com</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Talk to a Person</h2>
          <p class="cta-subtext">
            For quotations, specifications and availability, speak to our team.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Contact Us</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
