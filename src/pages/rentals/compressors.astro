---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Compressors - Velcorix Rentals",
  description: "Rent high-performance industrial air compressors in UAE. Velcorix offers portable diesel and electric compressors for pneumatic tools and plant air systems.",
  canonical: "https://www.velcorix.com/rentals/compressors.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Air Compressors",
      "description": "Rent high-performance industrial air compressors in UAE. Velcorix offers portable diesel and electric compressors for pneumatic tools and plant air systems.",
      "serviceType": "Equipment Rental",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/rentals/compressors.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rental Equipments",
          "item": "https://www.velcorix.com/rentals.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Air Compressors",
          "item": "https://www.velcorix.com/rentals/compressors.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/rentals/Liquid-Ring-Compressors.jpg');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Air Compressors</h1>
          <p class="lead">Reliable air compression for industrial applications</p>
        </div>
      </header>

      <!-- Content -->
      <!-- Intro Section -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/rentals/Rotary-Lobe-Compressors.jpg" class="img-fluid shadow intro-image" alt="Air Compressors" onerror="this.src='https://placehold.co/800x400?text=Air+Compressors'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Heavy-Duty Compression Solutions</h2>
              <p>
                Ensure continuous operation of your pneumatic tools and plant air
                systems with Velcorix's fleet of high-performance air compressors. 
                We offer solutions tailored for both construction sites and industrial facilities.
              </p>
              <p>
                Our inventory includes portable diesel compressors for mobility and 
                efficient electric units for stationary applications. We also provide 
                air dryers and high-pressure boosters for specialized testing requirements.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Offerings -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Offerings &amp; Scope</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Portable Diesel Compressors</h5>
                  <p class="text-muted mb-0">185 CFM to 1600 CFM units for construction use</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Electric Compressors</h5>
                  <p class="text-muted mb-0">Stationary screw compressors for plant air supply</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">High-Pressure Units</h5>
                  <p class="text-muted mb-0">Up to 25 bar for sandblasting and pressure testing</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Air Treatment</h5>
                  <p class="text-muted mb-0">Air dryers, filters, and moisture separators available</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-hammer"></i>
                </div>
                <h4>Construction</h4>
                <p class="small text-muted mb-0">
                  Powering jackhammers and pneumatic drills.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-oil-can"></i>
                </div>
                <h4>Oil &amp; Gas</h4>
                <p class="small text-muted mb-0">
                  Pipeline drying and pneumatic testing.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-paint-roller"></i>
                </div>
                <h4>Sandblasting</h4>
                <p class="small text-muted mb-0">
                  High-flow air for surface preparation and painting.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-industry"></i>
                </div>
                <h4>Manufacturing</h4>
                <p class="small text-muted mb-0">
                  Reliable compressed air for factory automation.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Technical Specifications</h2>
                  <div class="table-responsive shadow-sm bg-white p-0 rounded overflow-hidden">
                    <table class="table table-bordered mb-0">
                      <tbody>
                        <tr>
                          <th class="bg-primary text-white w-25">Pressure Range</th>
                          <td>7 bar - 25 bar</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Flow Rate</th>
                          <td>100 CFM - 1600 CFM</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Engine Type</th>
                          <td>Diesel Engine / Electric Motor</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Compressor Type</th>
                          <td>Oil-Injected Rotary Screw</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Mounting</th>
                          <td>Portable Wheel or Skid Mounted</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/rentals/Rotary-Screw-Compressors.jpg" alt="Compressor Specs" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Specifications'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Safety Features</h6>
                  <p class="small text-muted mb-0">Equipped with emergency stops and pressure relief valves for safe operation.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-truck-loading text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Hassle-Free Logistics</h6>
                  <p class="small text-muted mb-0">We handle the transportation and positioning of compressors at your site.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Regular Maintenance</h6>
                  <p class="small text-muted mb-0">Scheduled service visits included to keep equipment running at peak efficiency.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-tools text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Accessories</h6>
                  <p class="small text-muted mb-0">Hoses, manifolds, and efficient air dryers can be supplied as a package.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Need Air Power?</h2>
          <p class="cta-subtext">
            Contact us for reliable air compressor rentals tailored to your needs.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
