---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Binder Pullers - Velcorix Rentals",
  description: "Rent heavy-duty binder pullers and bundle extractors in UAE. Velcorix provides aerial and truck-mounted extractors for safe heat exchanger maintenance.",
  canonical: "https://www.velcorix.com/rentals/binder-pullers.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Binder Pullers",
      "description": "Rent heavy-duty binder pullers and bundle extractors in UAE. Velcorix provides aerial and truck-mounted extractors for safe heat exchanger maintenance.",
      "serviceType": "Equipment Rental",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/rentals/binder-pullers.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rental Equipments",
          "item": "https://www.velcorix.com/rentals.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Binder Pullers",
          "item": "https://www.velcorix.com/rentals/binder-pullers.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/rentals/binder-2.jpg');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Binder Pullers</h1>
          <p class="lead">Safe and efficient tube bundle extraction solutions</p>
        </div>
      </header>

      <!-- Content -->
      <!-- Intro Section -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/rentals/binder-3.jpeg" class="img-fluid shadow intro-image" alt="Binder Pullers" onerror="this.src='https://placehold.co/800x400?text=Binder+Pullers'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Heavy Duty Extraction Power</h2>
              <p>
                Velcorix provides high-capacity binder pullers designed to safely
                extract and re-insert heat exchanger tube bundles. Our equipment
                eliminates the need for manual handling, significantly reducing
                turnaround time and improving safety.
              </p>
              <p>
                Whether you need aerial extractors for elevated exchangers or
                truck-mounted units for ease of mobility, we have the right
                solution for your maintenance project.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Offerings -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Offerings &amp; Scope</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Aerial Bundle Extractors</h5>
                  <p class="text-muted mb-0">
                    Self-balancing units for crane-assisted extraction
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Truck Mounted Pullers</h5>
                  <p class="text-muted mb-0">
                    Self-propelled units for ground-level access
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Slab Mounted Units</h5>
                  <p class="text-muted mb-0">Compact pullers for tight spaces</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem"></i>
                <div>
                  <h5 class="fw-bold mb-1">Tube Bundle Carriers</h5>
                  <p class="text-muted mb-0">
                    Safe transport of bundles within the plant
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-clock"></i>
                </div>
                <h4>Turnarounds</h4>
                <p class="small text-muted mb-0">
                  Rapid extraction during time-critical shutdowns.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-arrow-up"></i>
                </div>
                <h4>Elevation Work</h4>
                <p class="small text-muted mb-0">
                  Extracting bundles from high columns and structures.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-cogs"></i>
                </div>
                <h4>Bundle Replacement</h4>
                <p class="small text-muted mb-0">
                  Installing new bundles with precision alignment.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-hard-hat"></i>
                </div>
                <h4>Maintenance</h4>
                <p class="small text-muted mb-0">
                  Removing bundles for cleaning and inspection.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-lg-6">
              <h2 class="mb-4 fw-bold">Technical Specifications</h2>
              <div class="table-responsive shadow-sm bg-white p-0 rounded overflow-hidden">
                <table class="table table-bordered mb-0">
                  <tbody>
                    <tr>
                      <th class="bg-primary text-white w-25">Pulling Capacity</th>
                      <td>Up to 65 Tons</td>
                    </tr>
                    <tr>
                      <th class="bg-primary text-white">Bundle Length</th>
                      <td>Max 12.5 meters</td>
                    </tr>
                    <tr>
                      <th class="bg-primary text-white">Bundle Diameter</th>
                      <td>Up to 3,000 mm</td>
                    </tr>
                    <tr>
                      <th class="bg-primary text-white">Weight Capacity</th>
                      <td>Up to 50 Tons</td>
                    </tr>
                    <tr>
                      <th class="bg-primary text-white">Drive System</th>
                      <td>Hydraulic (Diesel Engine Driven)</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="col-lg-6">
              <img src="/assets/images/rentals/binder.png" alt="Binder Puller Specs" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Specifications'">
            </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-check-circle text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Certified Equipment</h6>
                <p class="small text-muted mb-0">
                  All lifting and pulling gear is third-party certified for
                  safety.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-users-cog text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Experienced Operators</h6>
                <p class="small text-muted mb-0">
                  We can supply skilled operators to manage the extraction process
                  safely.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-tachometer-alt text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Precision Control</h6>
                <p class="small text-muted mb-0">
                  Hydraulic systems ensure smooth and controlled pulling to
                  prevent damage.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Safety Protocols</h6>
                <p class="small text-muted mb-0">
                  Adherence to strict site safety standards during all lifting
                  operations.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Heavy Lifting Made Easy</h2>
          <p class="cta-subtext">
            Rent powerful binder pullers for your next major turnaround.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
