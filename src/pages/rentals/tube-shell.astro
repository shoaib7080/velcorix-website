---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Tube & Shell Heat Exchangers - Velcorix Rentals",
  description: "Advanced equipment for tube and shell heat exchanger maintenance. Rent bundle pullers, cleaning systems, and retubing tools for industrial turnarounds in UAE.",
  canonical: "https://www.velcorix.com/rentals/tube-shell.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Tube & Shell Equipment",
      "description": "Advanced equipment for tube and shell heat exchanger maintenance. Rent bundle pullers, cleaning systems, and retubing tools for industrial turnarounds in UAE.",
      "serviceType": "Equipment Rental",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/rentals/tube-shell.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rental Equipments",
          "item": "https://www.velcorix.com/rentals.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Tube & Shell Equipment",
          "item": "https://www.velcorix.com/rentals/tube-shell.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/rentals/shell-and-tube-heat-exchangers-500x500.webp');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Tube &amp; Shell Equipment</h1>
          <p class="lead">Maintenance and replacement equipment for heat exchangers</p>
        </div>
      </header>

      <!-- Content -->
      <!-- Intro Section -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/rentals/t&amp;s-he.jpg" class="img-fluid shadow intro-image" alt="Tube &amp; Shell Equipment" onerror="this.src='https://placehold.co/800x400?text=Heat+Exchanger+Equipment'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Heat Exchanger Solutions</h2>
              <p>
                Velcorix supplies specialized equipment for the inspection, maintenance, 
                repair, and re-tubing of shell and tube heat exchangers. Our tools 
                are designed to improve efficiency during turnaround and shutdown activities.
              </p>
              <p>
                From powerful tube bundle pullers to precision cleaning systems and 
                testing plugs, we ensure your heat exchangers are serviced safely 
                and returned to optimal performance.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Offerings -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Offerings &amp; Scope</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Bundle Pullers</h5>
                  <p class="text-muted mb-0">Aerial and truck-mounted extractors for safe removal</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Tube Cleaning</h5>
                  <p class="text-muted mb-0">High-pressure water jetting lances and nozzles</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Retubing Tools</h5>
                  <p class="text-muted mb-0">Cutters, pullers, and expanders for tube replacement</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Testing Plugs</h5>
                  <p class="text-muted mb-0">Hydro and pneumatic plugs for leak detection</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-cogs"></i>
                </div>
                <h4>Shutdowns</h4>
                <p class="small text-muted mb-0">
                  Critical maintenance during plant shutdowns.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-industry"></i>
                </div>
                <h4>Refineries</h4>
                <p class="small text-muted mb-0">
                  Heat exchanger servicing in oil refineries.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-bolt"></i>
                </div>
                <h4>Power Plants</h4>
                <p class="small text-muted mb-0">
                  Condenser and cooler maintenance outages.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-flask"></i>
                </div>
                <h4>Petrochemical</h4>
                <p class="small text-muted mb-0">
                  Process heat exchanger cleaning and repair.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Technical Specifications</h2>
                  <div class="table-responsive shadow-sm bg-white p-0 rounded overflow-hidden">
                    <table class="table table-bordered mb-0">
                      <tbody>
                        <tr>
                          <th class="bg-primary text-white w-25">Bundle Weight</th>
                          <td>Up to 60 Tons (Puller capacity)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Bundle Length</th>
                          <td>Up to 12 meters / custom lengths</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Cleaning Pressure</th>
                          <td>Up to 40,000 PSI (Ultra High Pressure)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Tube Size Range</th>
                          <td>1/2" to 3" OD</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Mounting</th>
                          <td>Truck Mounted / Crane Suspended (Aerial)</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/rentals/t&amp;s-he-2.jpg" alt="Tube Shell Specs" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Specifications'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Safety First</h6>
                  <p class="small text-muted mb-0">Equipment comes with fail-safe mechanisms and deadman switches for operator safety.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-truck-loading text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Operator Training</h6>
                  <p class="small text-muted mb-0">We provide on-site training or certified operators for bundle extraction.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Inspection Services</h6>
                  <p class="small text-muted mb-0">IRIS and Eddy Current inspection services can be integrated with rental.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-tools text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Custom Tooling</h6>
                  <p class="small text-muted mb-0">Fabrication of custom jigs and fixtures for unique exchanger configurations.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Optimize Heat Transfer</h2>
          <p class="cta-subtext">
            Rent professional heat exchanger maintenance equipment today.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
