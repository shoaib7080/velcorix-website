---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Welding Equipment - Velcorix Rentals",
  description: "Rent certified welding machines for industrial projects in UAE. Velcorix offers high-quality multi-process and diesel-driven welding equipment for oil & gas and construction sectors.",
  canonical: "https://www.velcorix.com/rentals/welding.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Welding Equipment",
      "description": "Rent certified welding machines for industrial projects in UAE. Velcorix offers high-quality multi-process and diesel-driven welding equipment for oil & gas and construction sectors.",
      "serviceType": "Equipment Rental",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/rentals/welding.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rental Equipments",
          "item": "https://www.velcorix.com/rentals.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Welding Equipment",
          "item": "https://www.velcorix.com/rentals/welding.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/rentals/welding-2.png');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Welding Equipment</h1>
          <p class="lead">Precision welding solutions for every industry</p>
        </div>
      </header>

      <!-- Content -->
      <!-- Intro Section -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/rentals/welding.png" class="img-fluid shadow intro-image" alt="Welding Equipment" onerror="this.src='https://placehold.co/800x400?text=Welding+Equipment'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">High-Performance Welding Machines</h2>
              <p>
                Velcorix provides a variety of welding machines suitable for heavy
                industrial use, pipeline construction, and general fabrication. 
                Our fleet is well-maintained and ready for immediate mobilization.
              </p>
              <p>
                We offer both diesel engine-driven welders for remote sites without 
                power grids and electric welding inverters for workshop environments. 
                Our multi-process units ensure versatility for any project requirement.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Offerings -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Offerings &amp; Scope</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Diesel Welders</h5>
                  <p class="text-muted mb-0">Engine-driven 400A &amp; 500A units for off-grid sites</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Electric Inverters</h5>
                  <p class="text-muted mb-0">MIG, TIG, and Stick welding machines for precision</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Plasma Cutters</h5>
                  <p class="text-muted mb-0">High-capacity cutting equipment for metals</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Welding Accessories</h5>
                  <p class="text-muted mb-0">Cables, electrodes, helmets, and extraction units</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-oil-can"></i>
                </div>
                <h4>Oil &amp; Gas</h4>
                <p class="small text-muted mb-0">
                  Cross-country pipeline welding and repairs.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-gavel"></i>
                </div>
                <h4>Structural Steel</h4>
                <p class="small text-muted mb-0">
                  Heavy fabrication and steel structure erection.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-ship"></i>
                </div>
                <h4>Marine &amp; Offshore</h4>
                <p class="small text-muted mb-0">
                  Ship repair and rig maintenance works.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-wrench"></i>
                </div>
                <h4>Workshops</h4>
                <p class="small text-muted mb-0">
                  General fabrication and machinery repair.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Technical Specifications</h2>
                  <div class="table-responsive shadow-sm bg-white p-0 rounded overflow-hidden">
                    <table class="table table-bordered mb-0">
                      <tbody>
                        <tr>
                          <th class="bg-primary text-white w-25">Amperage Range</th>
                          <td>200A - 600A</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Duty Cycle</th>
                          <td>60% - 100% (Industrial Grade)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Processes</th>
                          <td>SMAW, GTAW, GMAW, FCAW (Multi-process)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">PowerType</th>
                          <td>Diesel Engine / Electric 3-Phase</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Auxiliary Power</th>
                          <td>3kVA - 10kVA (On Engine Driven Units)</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/rentals/welding-2.png" alt="Welding Specs" class="img-fluid rounded shadow w-80" onerror="this.src='https://placehold.co/600x400?text=Specifications'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Safety Certified</h6>
                  <p class="small text-muted mb-0">All equipment comes with valid calibration certificates and spark arrestors for hazardous zones.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-truck-loading text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Fast Mobilization</h6>
                  <p class="small text-muted mb-0">Same-day delivery available for urgent shutdown requirements.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Consumables Supply</h6>
                  <p class="small text-muted mb-0">We can supply high-quality electrodes and filler wires with the machines.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-tools text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">On-Site Repair</h6>
                  <p class="small text-muted mb-0">Technicians available for on-site troubleshooting to prevent delays.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Ready to Weld?</h2>
          <p class="cta-subtext">
            Rent high-quality welding machines for your next project.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
