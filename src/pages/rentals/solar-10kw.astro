---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "10kW Solar Kit - Velcorix Rentals",
  description: "High-capacity 10kW solar power kits for rent in UAE. Velcorix offers robust renewable energy solutions for construction camps and industrial sites with battery storage.",
  canonical: "https://www.velcorix.com/rentals/solar-10kw.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "10kW Solar Power Kit",
      "description": "High-capacity 10kW solar power kits for rent in UAE. Velcorix offers robust renewable energy solutions for construction camps and industrial sites with battery storage.",
      "serviceType": "Equipment Rental",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/rentals/solar-10kw.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rental Equipments",
          "item": "https://www.velcorix.com/rentals.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "10kW Solar Power Kit",
          "item": "https://www.velcorix.com/rentals/solar-10kw.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/rentals/solar-2.jpg');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">10kW Solar Power Kit</h1>
          <p class="lead">Robust renewable energy for camps and industrial sites</p>
        </div>
      </header>

      <!-- Content -->
      <!-- Intro Section -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/rentals/solar10kw-2.webp" class="img-fluid shadow intro-image" alt="10kW Solar Kit" onerror="this.src='https://placehold.co/800x400?text=Solar+Kit'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">High Capacity Solar Solution</h2>
              <p>
                The Velcorix 10kW Solar Power Kit is designed to meet the demands of larger 
                off-grid installations, such as construction camps, field offices, and 
                industrial workstations. It offers significant fuel savings by reducing 
                generator run-time.
              </p>
              <p>
                Scalable and robust, this system ensures a continuous power supply 
                even in harsh environments. We provide complete installation and 
                maintenance support, making the switch to solar effortless.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Offerings -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Features</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Extended Array</h5>
                  <p class="text-muted mb-0">Larger PV array for higher energy yield</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Advanced Inverter</h5>
                  <p class="text-muted mb-0">Intelligent load management and monitoring</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">High Capacity Storage</h5>
                  <p class="text-muted mb-0">Large battery bank for extended autonomy</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Hybrid Capability</h5>
                  <p class="text-muted mb-0">Seamless integration with diesel generators</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-bed"></i>
                </div>
                <h4>Accommodation</h4>
                <p class="small text-muted mb-0">
                  Powering staff quarters and amenities.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-building"></i>
                </div>
                <h4>Large Offices</h4>
                <p class="small text-muted mb-0">
                  Supporting multiple workstations and cooling.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-tint"></i>
                </div>
                <h4>Water Pumps</h4>
                <p class="small text-muted mb-0">
                  Running agriculture or dewatering pumps.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-warehouse"></i>
                </div>
                <h4>Workshops</h4>
                <p class="small text-muted mb-0">
                  Powering lights and small tools in remote workshops.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Technical Specifications</h2>
                  <div class="table-responsive shadow-sm bg-white p-0 rounded overflow-hidden">
                    <table class="table table-bordered mb-0">
                      <tbody>
                        <tr>
                          <th class="bg-primary text-white w-25">System Capacity</th>
                          <td>10 kWp</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Daily Generation</th>
                          <td>~ 40 - 50 kWh (avg)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Inverter Rating</th>
                          <td>10 kVA Hybrid (1-Phase / 3-Phase)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Battery Bank</th>
                          <td>48V / 96V / High Voltage Options</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Backup Time</th>
                          <td>Scalable based on load profile</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/rentals/solar10kw-2.webp" alt="Solar Specs" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Specifications'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-leaf text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Sustainability</h6>
                  <p class="small text-muted mb-0">Contributes to LEED certification and carbon reduction goals.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-tools text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Maintenance</h6>
                  <p class="small text-muted mb-0">Routine panel cleaning and system checks included.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-network-wired text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Integration</h6>
                  <p class="small text-muted mb-0">Can be integrated with existing gensets for fuel saving hybrid mode.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-headset text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Support</h6>
                  <p class="small text-muted mb-0">24/7 technical support for system troubleshooting.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Power Your Project Sustainably</h2>
          <p class="cta-subtext">
            Rent a 10kW Solar Power Kit for reliable, green energy.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
