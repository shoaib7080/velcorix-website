---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Hydrotesting Equipments - Velcorix Rentals",
  description: "Rent certified hydrotesting equipment in UAE. Velcorix provides high-pressure pumps, chart recorders, and accessories for pipeline and vessel integrity testing.",
  canonical: "https://www.velcorix.com/rentals/hydrotesting.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Hydrotesting Equipment",
      "description": "Rent certified hydrotesting equipment in UAE. Velcorix provides high-pressure pumps, chart recorders, and accessories for pipeline and vessel integrity testing.",
      "serviceType": "Equipment Rental",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/rentals/hydrotesting.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rental Equipments",
          "item": "https://www.velcorix.com/rentals.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Hydrotesting Equipment",
          "item": "https://www.velcorix.com/rentals/hydrotesting.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/rentals/hydrotest-2.jpg');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Hydrotesting Equipment</h1>
          <p class="lead">Complete solutions for pressure testing and validation</p>
        </div>
      </header>

      <!-- Content -->
      <!-- Intro Section -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/rentals/hydrotest-3.jpg" class="img-fluid shadow intro-image" alt="Hydrotesting Equipment" onerror="this.src='https://placehold.co/800x400?text=Hydrotesting+Equipment'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Precision Pressure Testing</h2>
              <p>
                Velcorix offers a comprehensive range of certified hydrotesting equipment 
                suitable for pipelines, pressure vessels, storage tanks, and valves. 
                Our equipment is calibrated and maintained to ensure accurate test 
                results for critical infrastructure.
              </p>
              <p>
                From high-volume filling pumps to high-pressure testing units and 
                precision recording instruments, we provide everything needed for 
                a successful and compliant hydrotest operation.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Offerings -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Offerings &amp; Scope</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">High Pressure Pumps</h5>
                  <p class="text-muted mb-0">Diesel and air-driven units up to 30,000 PSI</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Chart Recorders</h5>
                  <p class="text-muted mb-0">Barton recorders for accurate pressure logging</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Dead Weight Testers</h5>
                  <p class="text-muted mb-0">Primary standard for pressure calibration and testing</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Filling Pumps</h5>
                  <p class="text-muted mb-0">High-volume centrifugal pumps for rapid filling</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-network-wired"></i>
                </div>
                <h4>Pipeline Testing</h4>
                <p class="small text-muted mb-0">
                  Pre-commissioning validation of oil &amp; gas pipelines.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-database"></i>
                </div>
                <h4>Storage Tanks</h4>
                <p class="small text-muted mb-0">
                  Integrity testing of new and repaired storage tanks.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-flask"></i>
                </div>
                <h4>Pressure Vessels</h4>
                <p class="small text-muted mb-0">
                  Code-compliant testing of boilers and reactors.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-wrench"></i>
                </div>
                <h4>Valve Testing</h4>
                <p class="small text-muted mb-0">
                  Seat and shell testing of industrial valves.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Technical Specifications</h2>
                  <div class="table-responsive shadow-sm bg-white p-0 rounded overflow-hidden">
                    <table class="table table-bordered mb-0">
                      <tbody>
                        <tr>
                          <th class="bg-primary text-white w-25">Pressure Range</th>
                          <td>Up to 30,000 PSI</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Pump Type</th>
                          <td>Triplex Plunger / Air Driven Liquid Pump</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Flow Rate</th>
                          <td>Variable (High Volume to Low Volume / High Pressure)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Recording</th>
                          <td>Mechanical Chart / Digital Logging</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Accuracy</th>
                          <td>Up to 0.1% (with DWT/Digital Gauge)</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/rentals/hydrotest.jpg" alt="Hydrotesting Specs" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Specifications'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Calibrated Equipment</h6>
                  <p class="small text-muted mb-0">All gauges and recorders come with current calibration certificates traceable to standards.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-truck-loading text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Complete Skid</h6>
                  <p class="small text-muted mb-0">Pumps are skid-mounted with relief valves, manifolds, and hoses ready for site.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Technician Support</h6>
                  <p class="small text-muted mb-0">Experienced hydrotest technicians available to operate equipment and certify charts.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-tools text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Safety Accessories</h6>
                  <p class="small text-muted mb-0">Includes whip checks, pressure relief valves, and calibrated relief valves.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Test with Confidence</h2>
          <p class="cta-subtext">
            Rent certified hydrotesting equipment for your critical pressure tests.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
