---
import BaseLayout from "../../layouts/BaseLayout.astro";

const meta = {
  title: "Power Generators - Velcorix Rentals",
  description: "High-performance power generators for rent in UAE. Velcorix provides reliable, well-maintained generators for onshore and offshore industrial projects.",
  canonical: "https://www.velcorix.com/rentals/generators.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Power Generators",
      "description": "High-performance power generators for rent in UAE. Velcorix provides reliable, well-maintained generators for onshore and offshore industrial projects.",
      "serviceType": "Equipment Rental",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/rentals/generators.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rental Equipments",
          "item": "https://www.velcorix.com/rentals.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Power Generators",
          "item": "https://www.velcorix.com/rentals/generators.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('../assets/images/other/10kw-diesel-power-generator.jpg');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Power Generators</h1>
          <p class="lead">Reliable energy solutions for any project scale</p>
        </div>
      </header>

      <!-- Content -->
      <!-- Intro Section -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/other/10kw-diesel-power-generator-2.jpg" class="img-fluid shadow intro-image" alt="Generator Rental" onerror="this.src='https://placehold.co/800x400?text=Generator+Rental'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Reliable Power Generation</h2>
              <p>
                Velcorix provides certified, well-maintained rental equipment for
                shutdowns, commissioning, and industrial operations. Our fleet is
                maintained to meet site requirements and can be mobilized across
                the UAE.
              </p>
              <p>
                Whether you need temporary power for a construction site or a
                robust backup solution for a critical facility, our generators are
                designed to deliver consistent energy efficiency and operational
                safety.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Key Offerings -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Key Offerings &amp; Scope</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Diesel Generators</h5>
                  <p class="text-muted mb-0">15kVA to 2000kVA for versatile power applications</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Hybrid Power Solutions</h5>
                  <p class="text-muted mb-0">Eco-friendly options reducing fuel consumption</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Silent Canopies</h5>
                  <p class="text-muted mb-0">Acoustically compliant units for noise-sensitive areas</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">24/7 Support Included</h5>
                  <p class="text-muted mb-0">Mobilization, installation, commission, and site support</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      
      </section>

      <!-- Typical Applications -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
            <h2>Typical Real-World Applications</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-hard-hat"></i>
                </div>
                <h4>Construction</h4>
                <p class="small text-muted mb-0">
                  Powering cranes, improved site offices, and tools.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-oil-can"></i>
                </div>
                <h4>Oil &amp; Gas</h4>
                <p class="small text-muted mb-0">
                  Supporting shutdowns, maintenance, and drilling operations.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-music"></i>
                </div>
                <h4>Events</h4>
                <p class="small text-muted mb-0">
                  Reliable quiet power for large-scale events and concerts.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-hospital"></i>
                </div>
                <h4>Emergency</h4>
                <p class="small text-muted mb-0">
                  Critical standby power for hospitals and data centers.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Specifications -->
      <!-- Specifications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Technical Specifications</h2>
                  <div class="table-responsive shadow-sm bg-white p-0 rounded overflow-hidden">
                    <table class="table table-bordered mb-0">
                      <tbody>
                        <tr>
                          <th class="bg-primary text-white w-25">Capacity Range</th>
                          <td>15 kVA - 2000 kVA</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Voltage Options</th>
                          <td>220V - 480V (50Hz / 60Hz Switchable)</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Fuel Type</th>
                          <td>Diesel, Hybrid Options</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Mounting</th>
                          <td>Skid Mounted, Trailer Mounted</td>
                        </tr>
                        <tr>
                          <th class="bg-primary text-white">Noise Level</th>
                          <td>Super Silent options available (&lt;65dBA @ 7m)</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/other/10kw-diesel-power-generator.jpg" alt="Generator Specs" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Specifications'">
              </div>
          </div>
        </div>
      </section>


      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance &amp; Support</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Strict HSE Standards</h6>
                  <p class="small text-muted mb-0">Fully certified equipment meeting rigorous HSE standards including local municipality regulations.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-truck-loading text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Mobilization &amp; Setup</h6>
                  <p class="small text-muted mb-0">End-to-end logistics support from transportation to site installation and cabling.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Testing &amp; Commissioning</h6>
                  <p class="small text-muted mb-0">Comprehensive load bank testing and synchronization to ensure system reliability.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-tools text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">24/7 Site Support</h6>
                  <p class="small text-muted mb-0">Round-the-clock technical assistance and maintenance teams to minimize downtime.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Need Power Now?</h2>
          <p class="cta-subtext">
            Our team can assist with technical selection and availability
            immediately.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Request a Quote</a>
        </div>
        <div class="footer-divider"></div>
      </section>
</BaseLayout>
