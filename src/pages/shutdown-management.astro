---
import BaseLayout from "../layouts/BaseLayout.astro";

const meta = {
  title: "Shutdown & Turnaround Management - Velcorix Services",
  description: "Expert industrial shutdown and turnaround (TAR) management services in UAE. Velcorix ensures safe, efficient, and timely maintenance for oil refineries and petrochemical plants.",
  canonical: "https://www.velcorix.com/shutdown-management.html",
  schemas: [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Shutdown & Turnaround Management",
      "description": "Expert industrial shutdown and turnaround (TAR) management services in UAE. Velcorix ensures safe, efficient, and timely maintenance for oil refineries and petrochemical plants.",
      "serviceType": "Shutdown & Turnaround Management",
      "provider": {
        "@type": "Organization",
        "name": "Velcorix",
        "url": "https://www.velcorix.com/"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Arab Emirates"
      },
      "url": "https://www.velcorix.com/shutdown-management.html"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.velcorix.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.velcorix.com/services.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Shutdown & Turnaround Management",
          "item": "https://www.velcorix.com/shutdown-management.html"
        }
      ]
    }
  ],
};
---

<BaseLayout {...meta}>
  <!-- Header (Hero) -->
      <header class="bg-dark text-white text-center py-5" style="
          background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
            url('assets/images/services/DSC_2558.JPG');
          background-size: cover;
          background-position: center;
        ">
        <div class="container">
          <h1 class="display-4 fw-bold">Shutdown &amp; Turnaround Management</h1>
          <p class="lead">End-to-end planning and execution support for safe, compliant, and on-schedule shutdowns and turnarounds (TAR) across energy, oil &amp; gas, and heavy industrial operations.</p>
        </div>
      </header>

      <!-- Overview (Intro) -->
      <section class="section-padding">
        <div class="container">
          <div class="row">
            <div class="col-lg-6">
              <img src="/assets/images/services/DSC_2359.JPG" class="img-fluid shadow intro-image" alt="Shutdown Management" onerror="this.src='https://placehold.co/800x400?text=Shutdown+Management'">
            </div>
            <div class="col-lg-6 mb-4">
              <h2 class="mb-3">Minimizing Downtime, Maximizing Value</h2>
              <p>
                Planned shutdowns, turnarounds, and major maintenance outages are among the highest-risk operational events in industrial facilities. Every hour of delay increases production losses, safety exposure, and contractual risk.
              </p>
              <p>
               Velcorix provides specialized shutdown management services to help asset owners and operators:
              </p>
              <ul>
                <li>Minimize downtime and production losses</li>
                <li>Ensure safety and compliance</li>
                <li>Optimize project schedules and budgets</li>
                <li>Achieve first-time-right startup and handover</li>
              </ul>
           
            </div>
          </div>
        </div>
      </section>

      <!-- Scope / What’s Included (Key Offerings) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Shutdown &amp; Turnaround Scope</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Strategic Planning &amp; Readiness</h5>
                  <p class="text-muted mb-0">Long-range planning (T-18 months) covering feasibility, resource constraints, and operational readiness (OR).</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Scope Optimization &amp; Scheduling</h5>
                  <p class="text-muted mb-0">Rigorous "Scope Challenge" workshops to freeze scope, followed by detailed critical path scheduling (Primavera/MS Project).</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">Contractor &amp; Execution Strategy</h5>
                  <p class="text-muted mb-0">Selection and management of contractors, including risk assessment and contract negotiation.</p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
               <div class="d-flex align-items-start">
                <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
                <div>
                  <h5 class="fw-bold mb-1">HSE, Permit &amp; Compliance Management</h5>
                  <p class="text-muted mb-0">Implementation of HSE protocols, permit management, and compliance monitoring.</p>
                </div>
              </div>
            </div>
          </div>
          </div>
      


      <!-- Typical Applications -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="section-title">
            <h2>Industries We Serve</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-industry"></i>
                </div>
                <h4>Refineries</h4>
                <p class="small text-muted mb-0">
                  Complex unit shutdowns (e.g., Cat Crackers, Reformers).
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-bolt"></i>
                </div>
                <h4>Power Plants</h4>
                <p class="small text-muted mb-0">
                  Turbine overhauls and boiler inspections.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-water"></i>
                </div>
                <h4>Desalination</h4>
                <p class="small text-muted mb-0">
                  Maintenance of evaporators and intake systems.
                </p>
              </div>
            </div>
            <div class="col-md-3">
              <div class="service-card text-center h-100">
                <div class="service-icon">
                  <i class="fas fa-vial"></i>
                </div>
                <h4>Petrochemical</h4>
                <p class="small text-muted mb-0">
                   System cleaning and catalyst change-outs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capability Details (How We Do It) -->
      <section class="section-padding bg-light">
        <div class="container">
          <div class="row align-items-center">
              <div class="col-lg-6">
                  <h2 class="mb-4 fw-bold">Why Clients Trust Velcorix for Shutdown Management</h2>
                  <div class="bg-white p-4 rounded shadow-sm">
                     <p class="text-muted">
                      We turn shutdowns from chaotic events into controlled engineering exercises.
                     </p>
                     <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-start">
                          <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                          <div>
                            <strong>Pre-Shutdown:</strong> "Leak-free" start-up planning and long-lead item procurement consistent with our Operational Readiness (OR) framework.
                          </div>
                        </li>
                        <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Execution (Pit-Stop Philosophy):</strong> Treating every shift like an F1 pit-stop—maximizing tool time with 24/7 coverage and precise handover protocols.
                           </div>
                         </li>
                         <li class="mb-3 d-flex align-items-start">
                           <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                           <div>
                             <strong>Close-Out:</strong> Comprehensive reports capturing lessons learned, KPI performance, and restart verification.
                           </div>
                         </li>
                     </ul>
                  </div>
              </div>
              <div class="col-lg-6">
                   <img src="/assets/images/services/DSC_2408.JPG" alt="Shutdown Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Capabilities'">
              </div>
          </div>
        </div>
      </section>

      <!-- Compliance & Support -->
      <section class="section-padding">
        <div class="container">
          <div class="section-title">
              <h2>Compliance Standards</h2>
          </div>
          <div class="row g-4">
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">HSE Leadership</h6>
                  <p class="small text-muted mb-0">Zero Harm policy enforced by dedicated safety officers.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">QA/QC</h6>
                  <p class="small text-muted mb-0">Verification of all repairs against ASME/API codes.</p>
               </div>
            </div>
            <div class="col-md-3">
               <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                  <i class="fas fa-file-contract text-primary mb-3 fa-2x"></i>
                  <h6 class="fw-bold">Permit to Work</h6>
                  <p class="small text-muted mb-0">Rigorous management of PTW systems for all activities.</p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="cta-section text-center text-white">
        <div class="container">
          <h2 class="cta-heading">Plan for Success</h2>
          <p class="cta-subtext">
            Don't leave your shutdown to chance. Partner with Velcorix.
          </p>
          <a href="/contact.html" class="btn btn-primary btn-lg mt-3">Consult on Shutdowns</a>
        </div>
        <div class="footer-divider"></div>
      </section>

      </section>
</BaseLayout>
